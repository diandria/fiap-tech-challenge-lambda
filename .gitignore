node_modules/
dist/
coverage/

# O estado do Terraform guarda valores sensiveis e este repositorio e publico.
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
.terraform/
*.tfplan

.env

# Artefatos gerados pelo archive_file do Terraform a cada plan/apply.
# Versiona-los so produz diff em todo build e um zip desatualizado no repo,
# que nao corresponde ao codigo ao lado dele.
terraform/*.zip
